{
  "name": "chd-oclif",
  "version": "0.0.1",
  "author": "Zachary Edwards Downs",
  "description": "Tool to make changing to frequently visited directories faster",
  "repository": "https://github.com/zacharyedwardsdowns/chd-oclif.git",
  "homepage": "https://github.com/zacharyedwardsdowns/chd-oclif#readme",
  "bugs": "https://github.com/zacharyedwardsdowns/chd-oclif/issues",
  "license": "GPL-3.0",
  "type": "module",
  "bin": {
    "chd": "./bin/run.js"
  },
  "scripts": {
    "chd": "node bin/run.js"
  },
  "oclif": {
    "bin": "chd",
    "commands": "src/commands",
    "dirname": "chd-oclif",
    "topicSeparator": " ",
    "hooks": {
      "command_not_found": "src/hooks/command_not_found/cd"
    }
  },
  "dependencies": {
    "@inquirer/confirm": "^6.0.13",
    "@oclif/core": "^4.11.2",
    "better-sqlite3": "^12.9.0",
    "chalk": "^5.6.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.12.4",
    "oclif": "^4.23.0",
    "ts-node": "^10.9.2"
  },
  "packageManager": "pnpm@11.1.1+sha512.d1fdf5f73c617b64fa1a56a81c3c8dfe0e966e33a6010aa256b517ae77be21d93e05affc0de1a83b0e4f29d569f68b446ae8f068cd7247c0bb3df0fb4d7bdf9a"
}